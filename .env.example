# Supabase 프로젝트 설정 > API 에서 복사합니다. 실제 값은 .env.local 에만 넣고 커밋하지 마세요.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# publishable key(sb_publishable_...) 또는 기존 anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OAuth 콜백 이후 돌아올 사이트 주소 (로컬: http://localhost:3000, 배포: https://<도메인>)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 디스코드 OAuth의 Client ID / Secret 은 이 파일이 아니라
# Supabase 대시보드 > Authentication > Providers > Discord 에 입력합니다.

# 서버 전용. NEXT_PUBLIC_ 을 붙이지 마세요. 브라우저에 절대 노출되면 안 됩니다.
# Supabase 프로젝트 설정 > API Keys 의 secret key(sb_secret_...)
SUPABASE_SECRET_KEY=
# 운영 계정 blablalink 세션 암호화 키(32바이트 base64). node scripts/set-bot-session.mjs --new-key 로 만듭니다.
SESSION_ENCRYPTION_KEY=
